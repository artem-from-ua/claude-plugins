#!/usr/bin/env bash
# claude-marketplace-sync — Sync Claude Code plugin caches from marketplace sources.
#
# Claude Code has a bug where auto-updating a marketplace does not invalidate
# the plugin cache. This script pulls the latest marketplace content from
# remote and rsyncs it into the cache directory.
#
# Run before starting Claude Code, e.g. via a shell alias:
#   alias claude='claude-marketplace-sync && command claude'
#
# Upstream issues:
#   https://github.com/anthropics/claude-code/issues/14061
#   https://github.com/anthropics/claude-code/issues/15621
#   https://github.com/anthropics/claude-code/issues/15642

set -euo pipefail

PLUGINS_DIR="${HOME}/.claude/plugins"
MARKETPLACES_JSON="${PLUGINS_DIR}/known_marketplaces.json"
INSTALLED_JSON="${PLUGINS_DIR}/installed_plugins.json"
FRESHNESS_FILE="/tmp/claude-marketplace-sync-last-run"
FRESHNESS_WINDOW=300  # 5 minutes

verbose=false
force=false
sync_all=false

usage() {
    cat <<'EOF'
Usage: claude-marketplace-sync [OPTIONS]

Sync Claude Code plugin caches from marketplace sources.

Options:
  --force     Ignore freshness window and always sync
  --all       Sync all marketplaces, not just autoUpdate ones
  --verbose   Print detailed progress
  --help      Show this help
EOF
    exit 0
}

log() {
    if [ "$verbose" = true ]; then
        echo "[claude-marketplace-sync] $*" >&2
    fi
}

log_always() {
    echo "[claude-marketplace-sync] $*" >&2
}

# --- Parse arguments ---
while [ $# -gt 0 ]; do
    case "$1" in
        --force)   force=true ;;
        --all)     sync_all=true ;;
        --verbose) verbose=true ;;
        --help)    usage ;;
        *)         echo "Unknown option: $1" >&2; usage ;;
    esac
    shift
done

# --- Check freshness window ---
if [ "$force" = false ] && [ -f "$FRESHNESS_FILE" ]; then
    if [ "$(uname)" = "Darwin" ]; then
      last_run=$(stat -f %m "$FRESHNESS_FILE" 2>/dev/null || echo 0)
    else
      last_run=$(stat -c %Y "$FRESHNESS_FILE" 2>/dev/null || echo 0)
    fi
    now=$(date +%s)
    age=$(( now - last_run ))
    if [ "$age" -lt "$FRESHNESS_WINDOW" ]; then
        log_always "⏭️  Skipping sync (last run ${age}s ago)"
        exit 0
    fi
fi

log_always "🔄 Syncing Claude plugins..."

# --- Check prerequisites ---
if ! command -v jq &>/dev/null; then
    echo "claude-marketplace-sync: jq is required but not found" >&2
    exit 1
fi

if [ ! -f "$MARKETPLACES_JSON" ]; then
    log "No marketplaces found at ${MARKETPLACES_JSON}, nothing to do"
    exit 0
fi

if [ ! -f "$INSTALLED_JSON" ]; then
    log "No installed plugins found at ${INSTALLED_JSON}, nothing to do"
    exit 0
fi

# --- Resolve timeout command ---
TIMEOUT_CMD=""
if command -v timeout &>/dev/null; then
    TIMEOUT_CMD="timeout 10"
elif command -v gtimeout &>/dev/null; then
    TIMEOUT_CMD="gtimeout 10"
fi

# --- Pull marketplaces ---
marketplace_names=$(jq -r 'keys[]' "$MARKETPLACES_JSON")

echo "claude-marketplace-sync: syncing marketplaces..." >&2

for name in $marketplace_names; do
    auto_update=$(jq -r --arg n "$name" '.[$n].autoUpdate // false' "$MARKETPLACES_JSON")
    install_location=$(jq -r --arg n "$name" '.[$n].installLocation' "$MARKETPLACES_JSON")

    if [ "$sync_all" = false ] && [ "$auto_update" != "true" ]; then
        log "Skipping ${name} (autoUpdate not enabled)"
        continue
    fi

    if [ ! -d "${install_location}/.git" ]; then
        log "Skipping ${name} (no git repo at ${install_location})"
        continue
    fi

    log "Pulling ${name}..."
    if $TIMEOUT_CMD git -C "$install_location" pull --depth=1 origin main &>/dev/null; then
        log "  pulled OK"
    else
        log "  pull failed or timed out (continuing)"
    fi
done

# --- Sync installed plugins into cache ---
plugin_keys=$(jq -r '.plugins | keys[]' "$INSTALLED_JSON")

for key in $plugin_keys; do
    # key format: <plugin>@<marketplace>
    marketplace="${key##*@}"
    plugin="${key%%@*}"

    marketplace_location=$(jq -r --arg n "$marketplace" '.[$n].installLocation // empty' "$MARKETPLACES_JSON")
    if [ -z "$marketplace_location" ]; then
        log "Skipping ${key} (marketplace '${marketplace}' not found)"
        continue
    fi

    source_dir="${marketplace_location}/plugins/${plugin}"
    if [ ! -d "$source_dir" ]; then
        log "Skipping ${key} (source dir not found: ${source_dir})"
        continue
    fi

    # Read new version from marketplace source
    source_plugin_json="${source_dir}/.claude-plugin/plugin.json"
    if [ ! -f "$source_plugin_json" ]; then
        log "Skipping ${key} (no plugin.json in source)"
        continue
    fi

    new_version=$(jq -r '.version // ""' "$source_plugin_json" 2>/dev/null || echo "")
    if [ -z "$new_version" ]; then
        log "Skipping ${key} (no version in source plugin.json)"
        continue
    fi

    # Determine cache directory based on marketplace scope
    # Format: ~/.claude/plugins/cache/<marketplace>/<plugin>/<version>
    cache_base="${PLUGINS_DIR}/cache/${marketplace}/${plugin}"
    cache_dir="${cache_base}/${new_version}"

    # Get old version from existing cache (if any)
    old_version=""
    if [ -d "$cache_dir" ]; then
        old_plugin_json="${cache_dir}/.claude-plugin/plugin.json"
        if [ -f "$old_plugin_json" ]; then
            old_version=$(jq -r '.version // ""' "$old_plugin_json" 2>/dev/null || echo "")
        fi
    else
        # Directory doesn't exist yet, create it
        mkdir -p "$cache_dir"
    fi

    log "Syncing ${key} → ${cache_dir}"
    if rsync -a --delete "${source_dir}/" "${cache_dir}/" 2>/dev/null; then
        # Show update message only if version changed
        if [ -n "$old_version" ] && [ "$old_version" != "$new_version" ]; then
            log_always "✅ Updated: ${key} version ${new_version}"
        elif [ -z "$old_version" ]; then
            log_always "✅ Installed: ${key} version ${new_version}"
        fi
        log "  synced OK"
    else
        log_always "❌ Failed to sync ${key} → ${cache_dir}"
    fi
done

touch "$FRESHNESS_FILE" 2>/dev/null || true
log "Done"
