#!/bin/bash

# >>> artem-from-ua/plantuml >>>
# PlantUML sync + render check — installed by plantuml Claude Code plugin.
# Do not edit between markers; managed automatically by setup-project.sh.
#
# --check verifies two things: that each diagram's URL matches its source, and
# that the source still renders without deprecation warnings or syntax errors.
# The render lint asks plantuml.com about each diagram; when the server is
# unreachable it degrades to a warning, so commits still work offline.
PLANTUML_STAGED_MD=$(git diff --cached --name-only --diff-filter=ACM -- '*.md')

if [ -n "$PLANTUML_STAGED_MD" ]; then
    PLANTUML_ENCODER=""
    for candidate in \
        "$HOME/.claude/plugins/cache/artem-from-ua/plantuml/scripts/plantuml-encode.py" \
        "$HOME/.claude/plugins/marketplaces/artem-from-ua/plugins/plantuml/scripts/plantuml-encode.py" \
        "$(git rev-parse --show-toplevel 2>/dev/null)/scripts/plantuml-encode.py"; do
        if [ -f "$candidate" ]; then
            PLANTUML_ENCODER="$candidate"
            break
        fi
    done

    if [ -n "$PLANTUML_ENCODER" ]; then
        echo "Checking PlantUML diagrams in: $PLANTUML_STAGED_MD"
        if ! python3 "$PLANTUML_ENCODER" --check $PLANTUML_STAGED_MD; then
            echo ""
            echo "Commit blocked: PlantUML diagrams have unresolved issues."
            echo "  Out-of-sync URL: python3 $PLANTUML_ENCODER --sync <file.md>"
            echo "  Deprecated syntax or render error: fix the source block, then re-sync."
            exit 1
        fi
    fi
fi
# <<< artem-from-ua/plantuml <<<

# >>> artem-from-ua/shellcheck >>>
# ShellCheck gate for staged shell scripts — repo-local, not installed by a plugin.
#
# Lints the STAGED content (git show :file), not the worktree, so what is checked
# is exactly what is committed. Files are selected by sniffing the staged blob's
# shebang rather than by extension: three shell files here have no .sh suffix
# (.githooks/pre-commit, .githooks/pre-push, plugins/git-branch-naming/templates/pre-push),
# and plugins/plantuml/templates/pre-commit is a marker fragment with no shebang
# that must NOT be linted (it would fail SC2148).
#
# Severity is -S warning: error + warning block the commit, style stays advisory.
# Degrades silently when shellcheck is not installed.
# Set SHELLCHECK_SKIP=1 to bypass the gate for one commit.
if [ -z "$SHELLCHECK_SKIP" ] && command -v shellcheck >/dev/null 2>&1; then
    SHELLCHECK_STAGED=""
    SHELLCHECK_CANDIDATES=$(git diff --cached --name-only --diff-filter=ACMR)

    if [ -n "$SHELLCHECK_CANDIDATES" ]; then
        while IFS= read -r SHELLCHECK_FILE; do
            [ -n "$SHELLCHECK_FILE" ] || continue
            case "$(git show ":$SHELLCHECK_FILE" 2>/dev/null | head -n 1)" in
                '#!'*sh*) SHELLCHECK_STAGED="$SHELLCHECK_STAGED$SHELLCHECK_FILE
" ;;
            esac
        done <<EOF
$SHELLCHECK_CANDIDATES
EOF
    fi

    if [ -n "$SHELLCHECK_STAGED" ]; then
        echo "Checking shell scripts with shellcheck:"
        echo "$SHELLCHECK_STAGED" | sed '/^$/d; s/^/  /'

        SHELLCHECK_FAILED=0
        while IFS= read -r SHELLCHECK_FILE; do
            [ -n "$SHELLCHECK_FILE" ] || continue
            SHELLCHECK_OUT=$(git show ":$SHELLCHECK_FILE" 2>/dev/null \
                | shellcheck -S warning -f gcc - 2>&1 \
                | sed "s|^-:|$SHELLCHECK_FILE:|")
            if [ -n "$SHELLCHECK_OUT" ]; then
                echo "$SHELLCHECK_OUT"
                SHELLCHECK_FAILED=1
            fi
        done <<EOF
$SHELLCHECK_STAGED
EOF

        if [ "$SHELLCHECK_FAILED" -ne 0 ]; then
            echo ""
            echo "Commit blocked: staged shell scripts have shellcheck findings."
            echo "  Real defect: fix the code, then re-stage the file."
            echo "  Intentional pattern: add '# shellcheck disable=SCxxxx' above the line, with a reason comment."
            echo "  Pre-existing finding unrelated to your change: SHELLCHECK_SKIP=1 git commit ..."
            exit 1
        fi
    fi
fi
# <<< artem-from-ua/shellcheck <<<
